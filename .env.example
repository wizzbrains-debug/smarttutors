# SmartTutors Environment Variables Template
# Copy to .env.local for local development. Never commit .env.local to Git.

# ── 1. Google Gemini AI Service (Server-Side Only) ──
# Required by /api/chat serverless function to invoke Google Gemini.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override Gemini model name (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ── 2. Supabase Cloud / Staging Configuration ──
# Project URL: Safe for browser and server.
# Staging example: https://<staging-project-ref>.supabase.co
# Production reference: https://gfzffxvpmotjuydcvfav.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anon Key: Safe for browser and client-side requests.
# Used by frontend (js/auth.js) for student registration, login, and session refresh.
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Service Role Secret: STRICTLY SERVER-SIDE ONLY!
# NEVER expose this key in frontend code, public repositories, or client responses.
# Used exclusively by /api/chat to execute two-phase reservation & finalization RPCs:
# - reserve_student_ai_question
# - reserve_guest_ai_question
# - finalize_ai_question_reservation
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ── 3. Optional Security & Development Overrides ──
# Optional: Dedicated HMAC-SHA256 secret for signing st_guest_id cookies.
# If omitted, defaults safely to SUPABASE_SERVICE_ROLE_KEY.
# GUEST_COOKIE_SECRET=your_dedicated_cookie_signing_secret_here

# Local Development Fallback Switch (LOCAL ONLY):
# If set to true, allows /api/chat to run without Supabase during local testing.
# IMPORTANT: This flag is STRICTLY IGNORED in Vercel production and preview environments.
# ENABLE_LOCAL_DEV_FALLBACK=false
